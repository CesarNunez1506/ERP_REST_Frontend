# URL base del backend NestJS.
# Nest por defecto corre en 3000 y con app.setGlobalPrefix('api') las rutas
# quedan en http://localhost:3000/api/...
VITE_API_URL=http://localhost:3000/api

# Gateway de Socket.IO. Si se deja vacío, se deriva de VITE_API_URL quitándole
# el sufijo /api (el gateway de Nest comparte el servidor HTTP).
# VITE_SOCKET_URL=http://localhost:3000
# VITE_SOCKET_PATH=/socket.io

# Mientras el backend NestJS no esté listo, deja esto en "true":
# el frontend responde con un servidor simulado en memoria (mismo contrato REST)
# y un bus de eventos que imita al gateway. Cambia a "false" para pegarle a Nest.
VITE_USE_MOCK=true

# IGV Perú (18%). El backend es la fuente de verdad del monto;
# esto solo se usa para previsualizar totales antes de emitir el ticket.
VITE_IGV=0.18
